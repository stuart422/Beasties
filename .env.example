# Copy to .env for local use, or set these in Vercel > Project > Settings > Environment Variables.
# Never commit a real .env file.

# Postgres connection string (Neon or any Postgres). Leave empty locally to use the built-in
# local database (PGlite in data/pglite).
DATABASE_URL=

# Vercel Blob read-write token for a PRIVATE Blob store. Leave empty locally to keep photos in
# the photos/ folder.
BLOB_READ_WRITE_TOKEN=

# Random secret, at least 32 characters, used to protect session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The first owner account, created by `npm run db:setup`. Use Stuart's real email and a strong
# password (12+ characters). Remove OWNER_PASSWORD from the environment after the first setup.
OWNER_EMAIL=
OWNER_PASSWORD=
# Optional display name for the owner (default: Stuart)
OWNER_NAME=

# Beasties Assistant (OFF unless ASSISTANT_ENABLED=true). See ASSISTANT-SETUP.md.
# Set real keys in Vercel as Sensitive variables; never commit them.
# ASSISTANT_PROVIDER: faq (default, free, nothing leaves the server), gemini or anthropic.
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER=faq
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults: gemini-3.5-flash-lite for gemini, claude-haiku-5-5 for anthropic.
ASSISTANT_MODEL=
ASSISTANT_MONTHLY_MESSAGE_CAP=1500
